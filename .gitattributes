# Ensure Unix line endings for scripts even on Windows
* text=auto

*.sh     text eol=lf
*.chroot text eol=lf
*.yml    text eol=lf
*.md     text eol=lf
*.py     text eol=lf
*.json   text eol=lf
Makefile text eol=lf
rayen-ai text eol=lf

# Binary files
*.png    binary
*.jpg    binary
*.iso    binary
