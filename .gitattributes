# Ensure Unix line endings for scripts even on Windows
* text=auto

*.sh     text eol=lf
*.chroot text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.py     text eol=lf
*.json   text eol=lf
*.conf   text eol=lf
*.desc   text eol=lf
*.qml    text eol=lf
*.desktop text eol=lf
*.cfg    text eol=lf
Makefile text eol=lf
rayen-ai text eol=lf
apps/rayen-welcome text eol=lf
apps/rayen-control-center text eol=lf

# Binary files
*.png    binary
*.jpg    binary
*.iso    binary
