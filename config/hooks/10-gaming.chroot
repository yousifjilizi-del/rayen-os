#!/bin/bash
# Rayen OS — SteamOS-style gaming optimizations
# Ports SteamOS gaming configs: gamescope session, performance governor,
# kernel/gaming sysctls, MangoHud overlay. Best-effort: never aborts the build.
set -e

export DEBIAN_FRONTEND=noninteractive
LOG=/var/log/rayen-gaming.log
USER_HOME=/home/rayen

# --- 32-bit support (required by Steam / Proton) ---
dpkg --add-architecture i386 || true
apt-get update >/dev/null 2>&1 || true

# --- Steam (Ubuntu installer; pulls Valve repo + wine deps) ---
if ! command -v steam >/dev/null 2>&1; then
    apt-get install -y --no-install-recommends steam-installer >/dev/null 2>>"$LOG" || \
        echo "steam-installer failed; see $LOG" >> "$LOG"
fi

# --- gamescope (Valve compositor) if not already installed by package lists ---
if ! command -v gamescope >/dev/null 2>&1; then
    apt-get install -y --no-install-recommends gamescope >/dev/null 2>>"$LOG" || true
fi

# Fix any broken dependencies left by the best-effort installs above
apt-get install -f -y >/dev/null 2>&1 || true

# --- Steam Game Mode launcher (Steam Big Picture inside gamescope) ---
cat > /usr/bin/rayen-gamemode-launch << 'LAUNCH'
#!/bin/bash
# SteamOS-style: run Steam in Big Picture mode inside a gamescope compositor
if command -v gamescope >/dev/null 2>&1; then
    exec gamescope -f -e -r 60 -- steam -bigpicture
else
    exec steam -bigpicture
fi
LAUNCH
chmod +x /usr/bin/rayen-gamemode-launch

mkdir -p /usr/share/applications
cat > /usr/share/applications/rayen-gamemode.desktop << 'GMODE'
[Desktop Entry]
Type=Application
Version=1.0
Name=Steam Game Mode
Name[ar]=وضع الألعاب
GenericName=Big Picture
Comment=Steam Big Picture inside a gamescope session (SteamOS style)
Exec=/usr/bin/rayen-gamemode-launch
Icon=steam
Terminal=false
StartupNotify=true
Categories=Game;
Keywords=steam;gamescope;game;bigpicture;
GMODE

# --- GameMode toggle helper (used by the Control Center) ---
cat > /usr/bin/rayen-gamemode-toggle << 'GTOG'
#!/bin/bash
if gamemoded -s on >/dev/null 2>&1; then
    notify-send "GameMode" "وضع الأداء مفعّل" 2>/dev/null || true
    echo "GameMode ON"
else
    gamemoded -s off >/dev/null 2>&1 || true
    notify-send "GameMode" "وضع الأداء متوقف" 2>/dev/null || true
    echo "GameMode OFF"
fi
GTOG
chmod +x /usr/bin/rayen-gamemode-toggle

# --- CPU performance governor (SteamOS forces performance on AC power) ---
mkdir -p /etc/systemd/system
cat > /etc/systemd/system/rayen-gov.service << 'GOV'
[Unit]
Description=Rayen OS performance CPU governor
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=true
# Never fail: VMs often expose no cpufreq driver, so writes may be unsupported.
ExecStart=/bin/sh -c 'for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do [ -w "$g" ] && echo performance > "$g" 2>/dev/null || true; done'

[Install]
WantedBy=multi-user.target
GOV
systemctl enable rayen-gov.service >/dev/null 2>&1 || true
mkdir -p /etc/systemd/system/multi-user.target.wants
ln -sf /etc/systemd/system/rayen-gov.service /etc/systemd/system/multi-user.target.wants/rayen-gov.service
mkdir -p /etc/default
echo 'GOVERNOR="performance"' > /etc/default/cpufrequtils

# --- Gaming / Proton-friendly kernel tweaks (from SteamOS) ---
cat > /etc/sysctl.d/99-rayen-gaming.conf << 'SYS'
vm.swappiness=10
vm.max_map_count=2147483642
fs.inotify.max_user_watches=524288
net.core.rmem_max=134217728
net.core.wmem_max=134217728
SYS
sysctl -p /etc/sysctl.d/99-rayen-gaming.conf >/dev/null 2>&1 || true

# --- MangoHud overlay config (default for all games) ---
mkdir -p /etc/mangohud "${USER_HOME}/.config/MangoHud"
cat > /etc/mangohud/MangoHud.conf << 'MHO'
fps
fps_limit=0
gpu_stats
gpu_temp
cpu_stats
cpu_temp
ram
vram
frame_timing
position=top-left
refresh_rate=1000
MHO
cp /etc/mangohud/MangoHud.conf "${USER_HOME}/.config/MangoHud/MangoHud.conf"
chown -R rayen:rayen "${USER_HOME}/.config/MangoHud" 2>/dev/null || true

echo "Gaming setup complete. Log: $LOG"
