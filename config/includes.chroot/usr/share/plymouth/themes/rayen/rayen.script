# Rayen OS boot splash theme
# Shows the Rayen logo, name and a spinning progress indicator.

# Dark navy background gradient
Window.SetBackgroundTopColor(0.02, 0.09, 0.22);
Window.SetBackgroundBottomColor(0.01, 0.04, 0.09);

# Logo
logo = Image("logo.png");
logo_sprite = Sprite(logo);
logo_sprite.SetX(Window.GetWidth() / 2 - logo.GetWidth() / 2);
logo_sprite.SetY(Window.GetHeight() / 2 - logo.GetHeight() / 2 - 20);

# Progress spinner
spinner = Image("spinner.png");
spinner_sprite = Sprite(spinner);
spinner_sprite.SetX(Window.GetWidth() / 2 - spinner.GetWidth() / 2);
spinner_sprite.SetY(Window.GetHeight() / 2 + logo.GetHeight() / 2 + 10);
spinner_sprite.SetAnimation(on=true);
spinner_sprite.SetFramesPerSecond(rate=12);

# Title text
label = Label("Rayen OS");
label.SetFontFace("Sans");
label.SetFontSize(26);
label.SetColor(0.92, 0.96, 1.0, 1.0);
label.SetX(Window.GetWidth() / 2 - label.GetWidth() / 2);
label.SetY(Window.GetHeight() / 2 + logo.GetHeight() / 2 + 55);
