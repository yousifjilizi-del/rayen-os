# Rayen OS — Calamares installer + GRUB for installed systems
# grub-pc and grub-efi-amd64 CONFLICT; install the platform binaries instead
# so Calamares' bootloader module can target either BIOS or UEFI.
calamares
grub2-common
grub-pc-bin
grub-efi-amd64-bin
os-prober
parted
dosfstools
btrfs-progs
xfsprogs
squashfs-tools
xdg-utils
