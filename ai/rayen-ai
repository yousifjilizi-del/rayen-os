#!/usr/bin/env python3
"""Rayen AI - command-line assistant for Rayen OS."""
import argparse
import os
import sys

sys.path.insert(0, "/usr/share/rayen-ai")

from rayen_ai.config import load_config
from rayen_ai.engine import Engine
from rayen_ai.files import FileAccess

SYSTEM_PROMPT = (
    "You are Rayen AI, the built-in assistant of Rayen OS. "
    "Answer in the user's language (Arabic/Tunisian if they write Arabic). "
    "You can use the system's file tools to read files when the user asks "
    "about their system. Be concise and practical."
)


def _file_command(args):
    config = load_config()
    fa = FileAccess(config)
    if args.action == "ls":
        print(fa.ls(args.path))
    elif args.action == "cat":
        print(fa.read(args.path))
    elif args.action == "search":
        print(fa.search(args.term, args.path))
    else:
        print(f"Unknown file action: {args.action}", file=sys.stderr)
        sys.exit(1)


def _ask(args):
    config = load_config()
    engine = Engine(config)
    if args.messages:
        messages = [
            {"role": "system", "content": SYSTEM_PROMPT},
            {"role": "user", "content": args.messages},
        ]
        try:
            print(engine.chat(messages))
        except RuntimeError as exc:
            print(f"Error: {exc}", file=sys.stderr)
            sys.exit(1)
        return

    messages = [{"role": "system", "content": SYSTEM_PROMPT}]
    print("Rayen AI - interactive chat. Type 'exit' or Ctrl+D to quit.")
    print(f"Engine: {engine.current_name()}")
    while True:
        try:
            user_input = input("You> ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if not user_input:
            continue
        if user_input.lower() in ("exit", "quit"):
            break
        messages.append({"role": "user", "content": user_input})
        try:
            reply = engine.chat(messages)
        except RuntimeError as exc:
            print(f"Error: {exc}")
            continue
        print(f"Rayen> {reply}")
        messages.append({"role": "assistant", "content": reply})


def _status(args):
    config = load_config()
    engine = Engine(config)
    print(f"Qwen API:    {'configured' if engine.qwen.available else 'NOT configured'}")
    print(f"Local model: {'available' if engine.local.available else 'not available'}")
    print(f"Active:      {engine.current_name()}")


def main():
    parser = argparse.ArgumentParser(prog="rayen-ai", description="Rayen OS AI assistant")
    sub = parser.add_subparsers(dest="command", required=True)

    ask = sub.add_parser("ask", help="ask a question or start a chat")
    ask.add_argument("messages", nargs="?", default="")
    ask.set_defaults(func=_ask)

    chat = sub.add_parser("chat", help="start an interactive chat session")
    chat.set_defaults(func=_ask)

    status = sub.add_parser("status", help="show AI engine status")
    status.set_defaults(func=_status)

    fa = sub.add_parser("file", help="access system files")
    fa_sub = fa.add_subparsers(dest="action", required=True)
    ls = fa_sub.add_parser("ls")
    ls.add_argument("path", default="/home")
    ls.set_defaults(func=_file_command, action="ls")
    cat = fa_sub.add_parser("cat")
    cat.add_argument("path")
    cat.set_defaults(func=_file_command, action="cat")
    search = fa_sub.add_parser("search")
    search.add_argument("term")
    search.add_argument("path", nargs="?", default="/home")
    search.set_defaults(func=_file_command, action="search")

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
