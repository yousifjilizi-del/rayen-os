#!/usr/bin/env python3
"""Rayen OS - first-run Welcome screen."""
import os
import shlex
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, GdkPixbuf, Gtk, Pango  # noqa: E402

MARKER = os.path.expanduser("~/.config/rayen/welcome-done")
LOGO = "/usr/share/rayen/logo.png"

CSS = b"""
window { background-color: #0a1730; }
#brand { color: #eef2fb; }
#tagline { color: #9cc3ef; }
"""


def run(cmd):
    if not cmd:
        return
    try:
        subprocess.Popen(shlex.split(cmd))
    except Exception:
        pass


def action_button(label, icon, cmd):
    b = Gtk.Button(label=label)
    if icon:
        b.set_image(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.BUTTON))
        b.set_always_show_image(True)
    b.connect("clicked", lambda _w, c=cmd: run(c))
    return b


def main():
    if "--once" in sys.argv and os.path.exists(MARKER):
        return 0

    win = Gtk.Window(title="Rayen OS")
    win.set_default_size(620, 470)
    win.set_position(Gtk.WindowPosition.CENTER)
    win.set_resizable(False)
    win.set_direction(Gtk.TextDirection.RTL)

    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
    outer.set_margin_top(40)
    outer.set_margin_bottom(36)
    outer.set_margin_start(60)
    outer.set_margin_end(60)
    win.add(outer)

    if os.path.exists(LOGO):
        pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(LOGO, 100, 100, True)
        outer.pack_start(Gtk.Image.new_from_pixbuf(pix), False, False, 0)

    brand = Gtk.Label(label="Rayen OS")
    brand.get_style_context().add_class("brand")
    brand.override_font(Pango.FontDescription("Sans 26 bold"))
    outer.pack_start(brand, False, False, 10)

    tag = Gtk.Label(label="نظامك .. هويتك")
    tag.get_style_context().add_class("tagline")
    tag.override_font(Pango.FontDescription("Sans 14"))
    outer.pack_start(tag, False, False, 0)

    box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
    box.set_halign(Gtk.Align.CENTER)
    box.set_margin_top(32)
    outer.pack_start(box, False, False, 0)

    box.pack_start(action_button("مركز التحكم", "preferences-system",
                                 "rayen-control-center"), False, False, 0)
    box.pack_start(action_button("Rayen AI", "system-run",
                                 "pkexec xfce4-terminal -T \"Rayen AI\" -e /usr/bin/rayen-ai chat"),
                   False, False, 0)
    box.pack_start(action_button("تثبيت النظام", "drive-harddisk",
                                 "sudo -E /usr/bin/rayen-calamares"), False, False, 0)

    start = Gtk.Button(label="ابدأ الاستخدام")
    start.get_style_context().add_class("suggested-action")
    start.set_halign(Gtk.Align.CENTER)
    start.set_margin_top(34)

    def on_start(_w):
        try:
            os.makedirs(os.path.dirname(MARKER), exist_ok=True)
            with open(MARKER, "w") as fh:
                fh.write("done\n")
        except Exception:
            pass
        Gtk.main_quit()

    start.connect("clicked", on_start)
    outer.pack_start(start, False, False, 0)

    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
