#!/usr/bin/env python3
"""Rayen OS - Control Center (Windows Settings style)."""
import os
import shlex
import shutil
import socket
import subprocess

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, GdkPixbuf, Gtk, Pango  # noqa: E402

LOGO = "/usr/share/rayen/logo.png"
WALLPAPER_XFCONF = "/backdrop/screen0/monitor0/workspace0/last-image"

SECTIONS = [
    ("المظهر", "preferences-desktop-theme"),
    ("الشبكة والصوت", "preferences-system-network"),
    ("الألعاب", "applications-games"),
    ("أمن سيبراني", "security-high"),
    ("Rayen AI", "system-run"),
    ("النظام", "preferences-system"),
]
HOME_NAME = "الرئيسية"

SECURITY_TOOLS = ["nmap", "masscan", "sqlmap", "hashcat", "john", "hydra",
                  "aircrack-ng", "nikto", "gobuster", "wireshark", "msfconsole",
                  "binwalk", "steghide", "ettercap", "metasploit-framework", "zaproxy"]
GAMING_APPS = ["steam", "gamescope", "lutris", "mangohud", "gamemoded", "heroic"]


def run(cmd):
    try:
        subprocess.Popen(shlex.split(cmd))
    except Exception:
        pass


class ControlCenter(Gtk.Window):
    def __init__(self):
        super().__init__(title="إعدادات Rayen")
        self.set_default_size(860, 560)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_direction(Gtk.TextDirection.RTL)

        provider = Gtk.CssProvider()
        provider.load_from_data(b"""
        #sidebar { background-color: #141414; color: #e8eefb; }
        #sidebar row { color: #c9d6ef; font-size: 12px; }
        #sidebar row:selected { background-color: #2d2d2d; color: #ffffff; }
        #header { background-color: #141414; color: #ffffff; }
        #crumb { color: #cfcfcf; font-size: 12px; }
        #content { padding: 18px; }
        #card-title { font-size: 15px; font-weight: bold; color: #e8eefb; }
        #tile { background-color: #1c1c1c; border-radius: 8px; }
        #tile:hover { background-color: #2a2a2a; }
        #tile-label { font-size: 13px; color: #e8eefb; }
        """)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.build_header()
        self.grid = Gtk.Grid()
        self.grid.set_column_spacing(0)
        self.grid.set_row_spacing(0)
        self.add(self.grid)

        self.build_sidebar()
        self.build_stack()

    def build_header(self):
        header = Gtk.HeaderBar()
        header.set_name("header")
        header.set_show_close_button(True)
        header.props.title = "إعدادات Rayen"
        self.back = Gtk.Button.new_from_icon_name("go-previous-symbolic", Gtk.IconSize.BUTTON)
        self.back.set_tooltip_text("الرئيسية")
        self.back.connect("clicked", lambda _w: self.go_to(HOME_NAME))
        header.pack_start(self.back)
        self.crumb = Gtk.Label(label="الرئيسية")
        self.crumb.set_name("crumb")
        header.set_custom_title(self.crumb)
        self.set_titlebar(header)

    def build_sidebar(self):
        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        side.set_name("sidebar")
        side.set_size_request(200, -1)

        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        head.set_margin_top(16)
        head.set_margin_bottom(12)
        head.set_margin_start(14)
        head.set_margin_end(14)
        if os.path.exists(LOGO):
            pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(LOGO, 36, 36, True)
            head.pack_start(Gtk.Image.new_from_pixbuf(pix), False, False, 0)
        title = Gtk.Label(label="Rayen OS", xalign=0)
        title.override_font(Pango.FontDescription("Sans 12 bold"))
        head.pack_start(title, True, True, 0)
        side.pack_start(head, False, False, 0)

        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self._add_row(HOME_NAME, "go-home-symbolic")
        for name, icon in SECTIONS:
            self._add_row(name, icon)
        self.listbox.connect("row-selected", self.on_select)
        side.pack_start(self.listbox, True, True, 0)
        self.grid.attach(side, 0, 0, 1, 1)

    def _add_row(self, name, icon):
        row = Gtk.ListBoxRow()
        hb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        hb.set_margin_top(9)
        hb.set_margin_bottom(9)
        hb.set_margin_start(14)
        hb.set_margin_end(14)
        hb.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.MENU), False, False, 0)
        hb.pack_start(Gtk.Label(label=name, xalign=0), True, True, 0)
        row.add(hb)
        self.listbox.add(row)

    def on_select(self, _lb, row):
        if row is not None:
            self.go_to(self._row_name(row))

    def _row_name(self, row):
        if row.get_index() == 0:
            return HOME_NAME
        return SECTIONS[row.get_index() - 1][0]

    def go_to(self, name):
        self.stack.set_visible_child_name(name)
        self.crumb.set_text("الرئيسية > " + name if name != HOME_NAME else "الرئيسية")
        self.back.set_visible(name != HOME_NAME)
        if name == HOME_NAME:
            idx = 0
        else:
            idx = SECTIONS.index(next(s for s in SECTIONS if s[0] == name)) + 1
        self.listbox.select_row(self.listbox.get_row_at_index(idx))

    def build_stack(self):
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT)
        self.stack.add_titled(self.page_home(), HOME_NAME, HOME_NAME)
        self.stack.add_titled(self.page_appearance(), "المظهر", "المظهر")
        self.stack.add_titled(self.page_network(), "الشبكة والصوت", "الشبكة والصوت")
        self.stack.add_titled(self.page_gaming(), "الألعاب", "الألعاب")
        self.stack.add_titled(self.page_security(), "أمن سيبراني", "أمن سيبراني")
        self.stack.add_titled(self.page_ai(), "Rayen AI", "Rayen AI")
        self.stack.add_titled(self.page_system(), "النظام", "النظام")
        self.grid.attach(self.stack, 1, 0, 1, 1)

    def page_home(self):
        box = self.new_page()
        welcome = Gtk.Label(label="ماذا تريد أن تفعل؟", xalign=0)
        welcome.override_font(Pango.FontDescription("Sans 20 bold"))
        box.pack_start(welcome, False, False, 0)
        grid = Gtk.Grid()
        grid.set_column_spacing(10)
        grid.set_row_spacing(10)
        for i, (name, icon) in enumerate(SECTIONS):
            tile = Gtk.Button()
            tile.set_name("tile")
            tile.set_size_request(210, 90)
            vb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            vb.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DIALOG), True, True, 0)
            lab = Gtk.Label(label=name)
            lab.set_name("tile-label")
            vb.pack_start(lab, False, False, 0)
            tile.add(vb)
            tile.connect("clicked", lambda _w, n=name: self.go_to(n))
            grid.attach(tile, i % 2, i // 2, 1, 1)
        box.pack_start(grid, True, True, 0)
        return box

    def page_appearance(self):
        box = self.new_page()
        box.pack_start(self.card_action(
            "السمة والأيقونات", "تغيير سمة GTK وثيم الأيقونات",
            "preferences-desktop-theme", "xfce4-appearance-settings"), False, False, 0)
        box.pack_start(self.card_action(
            "خلفية سطح المكتب", "اختيار صورة للخلفية",
            "preferences-desktop-wallpaper", "wallpaper", special="wallpaper"), False, False, 0)
        box.pack_start(self.card_action(
            "الشاشة والدقة", "إعدادات العرض",
            "video-display", "xfce4-display-settings"), False, False, 0)
        box.pack_start(self.card_action(
            "شريط المهام والقوائم", "إعدادات اللوحة بأسلوب Windows",
            "preferences-system-windows", "xfce4-panel -c"), False, False, 0)
        return box

    def page_network(self):
        box = self.new_page()
        box.pack_start(self.card_action(
            "الاتصالات", "إدارة Wi-Fi و Ethernet",
            "network-workgroup", "nm-connection-editor"), False, False, 0)
        box.pack_start(self.card_action(
            "الصوت", "ضبط الصوت والميكروفون",
            "audio-volume-high", "pavucontrol"), False, False, 0)
        return box

    def page_gaming(self):
        box = self.new_page()
        box.pack_start(self.card_action(
            "Steam", "المتجر ومنصة الألعاب",
            "steam", "steam"), False, False, 0)
        box.pack_start(self.card_action(
            "وضع الألعاب (Game Mode)", "Steam Big Picture داخل Gamescope بأسلوب SteamOS",
            "media-playback-start-symbolic", "rayen-gamemode-launch"), False, False, 0)
        box.pack_start(self.card_action(
            "تفعيل / إيقاف وضع الأداء", "GameMode CPU/GPU",
            "cpu", "rayen-gamemode-toggle"), False, False, 0)
        box.pack_start(self.card_action(
            "Lutris", "إدارة ألعاب الويندوز",
            "applications-games", "lutris"), False, False, 0)
        frame = Gtk.Frame(label="المثبت حالياً")
        self.gaming_status = Gtk.Label(label="...", xalign=0)
        self.gaming_status.set_halign(Gtk.Align.START)
        self.gaming_status.set_margin_top(6)
        self.gaming_status.set_margin_bottom(6)
        self.gaming_status.set_margin_start(8)
        self.gaming_status.set_margin_end(8)
        frame.add(self.gaming_status)
        box.pack_start(frame, False, False, 8)
        self.load_gaming_status()
        return box

    def page_security(self):
        box = self.new_page()
        box.pack_start(self.card_action(
            "وحدة التحكم الأمنية", "قائمة بكل أدوات الأمن المثبتة (صلاحيات نظام)",
            "security-high",
            "pkexec xfce4-terminal -T 'Rayen Security' -e /usr/bin/rayen-sec"), False, False, 0)
        box.pack_start(self.card_action(
            "مسح الشبكة", "اكتشاف الأجهزة في شبكتك (nmap)",
            "network-workgroup",
            "pkexec xfce4-terminal -T 'Nmap' -e bash -c 'nmap -sn 192.168.1.0/24; echo; read -p \"اضغط Enter...\"'"),
            False, False, 0)
        box.pack_start(self.card_action(
            "فحص المنافذ", "فحص المنافذ المفتوحة (nmap -sS)",
            "dialog-password",
            "pkexec xfce4-terminal -T 'Nmap' -e bash -c 'nmap -sS -T4 localhost; echo; read -p \"اضغط Enter...\"'"),
            False, False, 0)
        box.pack_start(self.card_action(
            "Wireshark", "تحليل الحزم والشبكات",
            "applications-internet", "wireshark"), False, False, 0)
        box.pack_start(self.card_action(
            "OWASP ZAP", "اختبار ثغرات تطبيقات الويب",
            "applications-development", "zaproxy"), False, False, 0)
        frame = Gtk.Frame(label="حالة أدوات الأمن")
        self.sec_status = Gtk.Label(label="...", xalign=0)
        self.sec_status.set_halign(Gtk.Align.START)
        self.sec_status.set_line_wrap(True)
        self.sec_status.set_margin_top(6)
        self.sec_status.set_margin_bottom(6)
        self.sec_status.set_margin_start(8)
        self.sec_status.set_margin_end(8)
        frame.add(self.sec_status)
        box.pack_start(frame, False, False, 8)
        self.load_sec_status()
        return box

    def page_ai(self):
        box = self.new_page()
        box.pack_start(self.card_action(
            "فتح Rayen AI", "مساعد النظام بصلاحيات نظامية",
            "system-run",
            'pkexec xfce4-terminal -T "Rayen AI" -e /usr/bin/rayen-ai chat'), False, False, 0)
        frame = Gtk.Frame(label="حالة Rayen AI")
        self.ai_status = Gtk.Label(label="...", xalign=0)
        self.ai_status.set_halign(Gtk.Align.START)
        self.ai_status.set_margin_top(6)
        self.ai_status.set_margin_bottom(6)
        self.ai_status.set_margin_start(8)
        self.ai_status.set_margin_end(8)
        frame.add(self.ai_status)
        box.pack_start(frame, False, False, 0)
        refresh = Gtk.Button(label="تحديث الحالة")
        refresh.set_halign(Gtk.Align.START)
        refresh.connect("clicked", lambda _w: self.load_ai_status())
        box.pack_start(refresh, False, False, 8)
        self.load_ai_status()
        return box

    def page_system(self):
        box = self.new_page()
        info = Gtk.Label(label="", xalign=0)
        info.set_halign(Gtk.Align.START)
        info.override_font(Pango.FontDescription("Monospace 11"))
        info.set_line_wrap(True)
        box.pack_start(info, False, False, 0)
        self.load_system_info(info)
        box.pack_start(self.card_action(
            "الإعدادات الكاملة", "كل إعدادات Xfce",
            "preferences-system", "xfce4-settings-manager"), False, False, 10)
        box.pack_start(self.card_action(
            "تحديث النظام", "apt update && apt upgrade",
            "software-update-available",
            'pkexec xfce4-terminal -T "تحديث النظام" -e bash -c "apt update && apt upgrade && read -p \'اضغط Enter\'"'),
            False, False, 0)
        box.pack_start(self.card_action(
            "تثبيت Rayen OS", "المثبت الكامل على القرص",
            "drive-harddisk", "sudo -E /usr/bin/rayen-calamares"), False, False, 10)
        return box

    def new_page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_name("content")
        return box

    def card_action(self, title, subtitle, icon, cmd, special=None):
        card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        card.set_margin_top(6)
        card.set_margin_bottom(6)
        card.set_margin_start(4)
        card.set_margin_end(4)

        img = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DIALOG)
        img.set_pixel_size(40)
        card.pack_start(img, False, False, 0)

        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        t = Gtk.Label(label=title, xalign=0)
        t.override_font(Pango.FontDescription("Sans 13 bold"))
        s = Gtk.Label(label=subtitle, xalign=0)
        s.get_style_context().add_class("dim-label")
        s.set_line_wrap(True)
        s.set_max_width_chars(40)
        texts.pack_start(t, False, False, 0)
        texts.pack_start(s, False, False, 0)
        card.pack_start(texts, True, True, 0)

        b = Gtk.Button(label="فتح")
        b.get_style_context().add_class("suggested-action")
        if special == "wallpaper":
            b.connect("clicked", lambda _w: self.pick_wallpaper())
        else:
            b.connect("clicked", lambda _w, c=cmd: run(c))
        card.pack_start(b, False, False, 0)
        return card

    def pick_wallpaper(self):
        dlg = Gtk.FileChooserDialog(
            title="اختر خلفية", parent=self,
            action=Gtk.FileChooserAction.OPEN)
        dlg.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
                        Gtk.STOCK_OPEN, Gtk.ResponseType.OK)
        filt = Gtk.FileFilter()
        filt.set_name("Images")
        filt.add_mime_type("image/png")
        filt.add_mime_type("image/jpeg")
        dlg.add_filter(filt)
        if dlg.run() == Gtk.ResponseType.OK:
            path = dlg.get_filename()
            run('xfconf-query -c xfce4-desktop -p %s -s "%s"' % (WALLPAPER_XFCONF, path))
        dlg.destroy()

    def _installed(self, tools):
        found = []
        for t in tools:
            path = shutil.which(t) or (t == "metasploit-framework" and shutil.which("msfconsole"))
            if path:
                found.append(t)
        return found

    def load_ai_status(self):
        try:
            out = subprocess.check_output(
                ["/usr/bin/rayen-ai", "status"], stderr=subprocess.STDOUT,
                text=True, timeout=20).strip()
        except Exception as exc:
            out = "rayen-ai: %s" % exc
        self.ai_status.set_text(out)

    def load_sec_status(self):
        found = self._installed(SECURITY_TOOLS)
        self.sec_status.set_text("الأدوات المثبتة (%d):\n%s" % (
            len(found), "، ".join(found) if found else "لا شيء"))

    def load_gaming_status(self):
        found = self._installed(GAMING_APPS)
        self.gaming_status.set_text("مثبتة: " + ("، ".join(found) if found else "لا شيء"))

    def load_system_info(self, label):
        try:
            with open("/etc/os-release") as fh:
                osrel = {}
                for line in fh:
                    if "=" in line:
                        k, _, v = line.partition("=")
                        osrel[k] = v.strip().strip('"')
            pretty = osrel.get("PRETTY_NAME", "Rayen OS")
        except Exception:
            pretty = "Rayen OS"
        mem_total = mem_avail = 0
        try:
            with open("/proc/meminfo") as fh:
                for line in fh:
                    if line.startswith("MemTotal:"):
                        mem_total = int(line.split()[1]) // 1024
                    elif line.startswith("MemAvailable:"):
                        mem_avail = int(line.split()[1]) // 1024
        except Exception:
            pass
        try:
            usage = shutil.disk_usage("/")
            disk_total = usage.total // (1024 ** 3)
            disk_free = usage.free // (1024 ** 3)
        except Exception:
            disk_total = disk_free = 0
        lines = [
            "النظام:  %s" % pretty,
            "الجهاز:  %s" % socket.gethostname(),
            "النواة:  %s" % os.uname().release,
            "المعالج: %s" % os.uname().machine,
            "الذاكرة: %d GB متاحة من %d GB" % (mem_avail, mem_total),
            "القرص:   %d GB متاح من %d GB" % (disk_free, disk_total),
        ]
        label.set_text("\n".join(lines))


def main():
    win = ControlCenter()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    win.go_to(HOME_NAME)
    Gtk.main()
    return 0


if __name__ == "__main__":
    import sys
    sys.exit(main())
